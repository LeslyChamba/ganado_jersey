# ─── BASE ───────────────────────────────────────────────
APP_NAME=PROMAGA
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development   # development | production

# ─── SEGURIDAD ──────────────────────────────────────────
SECRET_KEY=cambia_esto_por_una_clave_secreta_muy_larga_y_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── BASE DE DATOS ──────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=promaga_db

# ─── ALMACENAMIENTO DE IMÁGENES ─────────────────────────
# Opciones: "local" o "s3"
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10

# Si usas S3 / MinIO:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=promaga-images
# AWS_S3_REGION=us-east-1

# ─── ROBOFLOW ───────────────────────────────────────────
ROBOFLOW_API_KEY=tu_api_key_de_roboflow
ROBOFLOW_WORKSPACE=tu_workspace
ROBOFLOW_PROJECT_CATTLE=live_cattle       # Modelo segmentación silueta
ROBOFLOW_MODEL_VERSION=1

# ─── CORS ───────────────────────────────────────────────
# Separar múltiples orígenes con coma
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://ganado-jersey.vercel.app
